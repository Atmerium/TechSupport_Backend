generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model brands {
  brandId          Int      @id @default(autoincrement())
  brandName        String
  brandDescription String?  @db.Text
  partId           Int?
  brandVisible     Boolean? @default(true)
  part             parts?   @relation(fields: [partId], references: [partId])
}

model users {
  userId         Int        @id @default(autoincrement())
  userEmail      String     @unique
  userPassword   String
  userRole       String     @default("user")
  userRememberMe Boolean    @default(false)
  userVisible    Boolean?   @default(true)
  tokens         token[]
  comments       comments[]
}

model token {
  token  String @id
  user   users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int
}

model parts {
  partId          Int      @id @default(autoincrement())
  partName        String
  partDescription String?  @db.Text
  partVisible     Boolean? @default(true)
  brands          brands[]
}

model builds {
  buildId          Int        @id @default(autoincrement())
  buildName        String
  buildDescription String?    @db.Text
  buildVisible     Boolean?   @default(true)
  buildCategory    Int        @default(1)
  buildClass       Int?       @default(1)
  comments         comments[]
}

model comments {
  commentId      Int      @id @default(autoincrement())
  commentContent String   @db.Text
  commentVisible Boolean? @default(true)
  commentDate    DateTime @default(now())
  buildId        Int
  userId         Int
  builds         builds   @relation(fields: [buildId], references: [buildId], onDelete: Cascade)
  users          users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
}
